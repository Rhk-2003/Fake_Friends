# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# NEVER commit the real file.

# --- Encryption (required when using GitHub storage) ------------------------
# Generate once:  python -c "from ff.crypto import generate_master_key as g; print(g())"
# Lose it and the saved data can never be read again. Changing it has the same effect.
FF_MASTER_KEY = "PASTE-GENERATED-KEY-HERE"

# --- Permanent storage on GitHub -------------------------------------------
# Fine-grained personal access token, limited to ONE repository,
# permission "Contents: Read and write". Nothing else.
GITHUB_TOKEN = "github_pat_xxx"
GITHUB_REPO = "your-username/fake-friends"
# Data lives on its own branch so saves never redeploy the app. Created automatically.
GITHUB_DATA_BRANCH = "ff-data"
# GITHUB_DATA_PATH = "vault"

# --- AI grading of short answers -------------------------------------------
GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-2.5-flash-lite"

# --- Optional ---------------------------------------------------------------
# Public address of the app, used for share links and QR codes.
APP_BASE_URL = "https://your-app.streamlit.app"
# By default the FIRST admin account ever created is the super-admin.
# Set this to pin the super-admin to a specific username instead.
# SUPER_ADMIN_USERNAME = "hk"
# FF_MAX_VIDEO_MB = "20"
