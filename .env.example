# Environment-variable alternative to .streamlit/secrets.toml (same names).
# Streamlit secrets take priority when both are set.

FF_MASTER_KEY=
# "github" or "local". Auto: github when GITHUB_TOKEN and GITHUB_REPO are set.
FF_STORAGE=
FF_DATA_DIR=data

GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_DATA_BRANCH=ff-data
GITHUB_DATA_PATH=vault

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

APP_BASE_URL=
SUPER_ADMIN_USERNAME=
FF_MAX_VIDEO_MB=20
